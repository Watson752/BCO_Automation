# Add these values to the environment used by your self-hosted n8n container.
# Never commit the completed file to Git.
APIFY_TOKEN=apify_api_REPLACE_ME
BCO_GOOGLE_SHEET_ID=REPLACE_WITH_GOOGLE_SHEET_ID

# Required only if your n8n instance blocks environment access from node expressions.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
